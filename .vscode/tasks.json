{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "writer-reviewer: server",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "${workspaceFolder}/ai/writer_reviewer_workflow/main.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}/ai/writer_reviewer_workflow"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "writer-reviewer: cli",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "${workspaceFolder}/ai/writer_reviewer_workflow/main.py",
        "--cli",
        "--prompt",
        "Write a concise announcement for a new hiking app release."
      ],
      "options": {
        "cwd": "${workspaceFolder}/ai/writer_reviewer_workflow"
      },
      "problemMatcher": []
    }
  ]
}